# Steam Deck SSH deploy target (used by `pnpm deploy`)
DECK_IP=192.168.1.x
DECK_PORT=22
# Use $HOME, not ~ - the value is sourced as a literal string
DECK_KEY=$HOME/.ssh/id_ed25519
# The deck user's login/sudo password - decky-cli needs it to chmod files
# and restart plugin_loader.service as root, even when SSH itself uses a key
DECK_PASS=
DECK_DIR=/home/deck
